rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    function validProduct(data) {
      return data.keys().hasAll([
          'nombre',
          'precio',
          'categoria',
          'imagen',
          'descripcion',
          'tiempo',
          'destacada'
        ])
        && data.keys().hasOnly([
          'nombre',
          'precio',
          'categoria',
          'imagen',
          'descripcion',
          'tiempo',
          'destacada',
          'imagenCredito'
        ])
        && data.nombre is string
        && data.nombre.size() > 0
        && data.precio is number
        && data.precio > 0
        && data.categoria is string
        && data.imagen is string
        && data.descripcion is string
        && data.tiempo is string
        && data.destacada is bool;
    }

    match /admins/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && validProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    match /carts/{userId} {
      function ownsAnonymousCart() {
        return request.auth != null
          && request.auth.uid == userId
          && request.auth.token.firebase.sign_in_provider == 'anonymous';
      }

      allow read, delete: if ownsAnonymousCart();
      allow create, update: if ownsAnonymousCart()
        && request.resource.data.keys().hasAll(['items', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 50;
    }
  }
}
